{
  "name": "mandate",
  "private": true,
  "version": "0.1.0",
  "description": "Claude executes real on-chain financial actions inside limits you set, with a hardware tap for anything irreversible.",
  "license": "MIT",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts -vv",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm build:packages && pnpm --filter @mandate/web dev",
    "e2e": "pnpm --filter @yashjain99/mandate-sdk e2e",
    "build:packages": "pnpm -r --filter @yashjain99/mandate-sdk --filter @yashjain99/mandate-ai --filter @yashjain99/mandate-mcp build",
    "publish:packages": "pnpm -r --filter @yashjain99/mandate-sdk --filter @yashjain99/mandate-ai --filter @yashjain99/mandate-mcp publish --access public --no-git-checks",
    "test": "pnpm --filter @yashjain99/mandate-sdk test",
    "prepare": "pnpm build:packages"
  }
}
