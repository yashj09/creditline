# ───────────── RPCs (public defaults work; an Alchemy/QuickNode Base Sepolia URL is more reliable) ─────────────
BASE_SEPOLIA_RPC=https://sepolia.base.org
ARC_TESTNET_RPC=https://rpc.testnet.arc.io
ARB_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc

# ───────────── Roles (TESTNET KEYS ONLY — never reuse mainnet keys) ─────────────
# Deployer = owner for the demo. Needs Base Sepolia ETH + Arc testnet USDC (gas).
DEPLOYER_PRIVATE_KEY=0x
OWNER_PRIVATE_KEY=0x            # same as deployer for the demo
OWNER_ADDRESS=0x

# Guardian = your Ledger's Ethereum address (44'/60'/0'/0/0). DEPLOY-TIME ONLY: after deployment the runtime reads
# guardian() from the account on each chain; change it with setGuardian on BOTH chains, not here.
GUARDIAN_ADDRESS=0x
GUARDIAN_PRIVATE_KEY=0x         # e2e script only (dev stand-in for the Ledger); leave empty when using the device

# Agent wallet — EITHER a local key (simplest) OR Circle developer-controlled wallets (Arc track credit).
AGENT_PRIVATE_KEY=0x            # needs a little Base Sepolia ETH and Arc USDC for gas
AGENT_ADDRESS=0x                # address of the agent wallet (local key or Circle wallet)
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=         # openssl rand -hex 32, then: pnpm exec tsx scripts/circle-setup.ts --register
# CIRCLE_WALLET_SET_ID=         # printed by scripts/circle-setup.ts

# Filled after deployment (used by SetPolicy.s.sol and cast commands)
ACCOUNT=0x

# ───────────── Data & model ─────────────
GRAPH_API_KEY=                  # Subgraph Studio → API keys
ANTHROPIC_API_KEY=              # or leave empty and use Bedrock:
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# ANTHROPIC_MODEL=claude-opus-5

# ───────────── Web app ─────────────
TOOL_APPROVAL_SECRET=change-me-random-string
RECIPIENT=0x000000000000000000000000000000000000dEaD   # demo payee on Arc (e2e script)
# NEXT_PUBLIC_DEV_GUARDIAN_KEY=0x   # dev-only: sign approvals in the browser without a Ledger (its address must be the account's on-chain guardian())
# CRON_SECRET=
# REMIND_DAYS=2
