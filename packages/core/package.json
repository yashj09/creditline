{
  "name": "@yashjain99/mandate-sdk",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "development": "./src/index.ts"
    },
    "./ledger-web": {
      "types": "./dist/ledger-web.d.ts",
      "import": "./dist/ledger-web.js",
      "development": "./src/ledger-web.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "gen:abi": "tsx scripts/gen-abi.ts",
    "e2e": "tsx scripts/e2e.ts",
    "test": "vitest run",
    "build": "tsup",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "viem": "^2.56.3",
    "tsup": "^8.5.0",
    "@ledgerhq/device-management-kit": "^1.9.0",
    "@ledgerhq/device-signer-kit-ethereum": "^1.18.0",
    "@ledgerhq/device-transport-kit-node-hid": "^1.0.1",
    "@ledgerhq/device-transport-kit-web-hid": "^1.2.4",
    "@ledgerhq/context-module": "^2.5.0",
    "rxjs": "^7.8.2",
    "@circle-fin/developer-controlled-wallets": "^10.8.0",
    "dotenv": "^17.2.0"
  },
  "description": "Bounded delegation for AI agents: a smart account with on-chain caps, an allow-list policy and a hardware guardian; planner, simulator, executor, approvals and market data.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "viem": "^2.30.0"
  },
  "peerDependenciesMeta": {
    "@ledgerhq/device-management-kit": {
      "optional": true
    },
    "@ledgerhq/device-signer-kit-ethereum": {
      "optional": true
    },
    "@ledgerhq/device-transport-kit-node-hid": {
      "optional": true
    },
    "@ledgerhq/device-transport-kit-web-hid": {
      "optional": true
    },
    "@ledgerhq/context-module": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    },
    "@circle-fin/developer-controlled-wallets": {
      "optional": true
    }
  },
  "keywords": [
    "ai-agents",
    "agentic",
    "smart-account",
    "ledger",
    "usdc",
    "cctp",
    "arc",
    "the-graph",
    "delegation",
    "guardian"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yashj09/mandate",
    "directory": "packages/sdk"
  }
}
